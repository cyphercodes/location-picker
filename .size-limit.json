[
  {
    "name": "location-picker/utils (parser + formatter)",
    "path": "dist/utils.mjs",
    "import": "*",
    "limit": "1.75 kB"
  },
  {
    "name": "location-picker/core: import { LocationPicker }",
    "path": "dist/core.mjs",
    "import": "{ LocationPicker }",
    "limit": "18.5 kB",
    "ignore": [
      "./leaflet.mjs",
      "./google.mjs",
      "./maplibre.mjs",
      "./photon.mjs",
      "./webmcp.mjs",
      "../leaflet.mjs",
      "../google.mjs",
      "../maplibre.mjs",
      "../photon.mjs",
      "../webmcp.mjs",
      "./_chunks/combobox-*",
      "./combobox-*"
    ]
  },
  {
    "name": "location-picker (root: core + element + define)",
    "path": "dist/index.mjs",
    "import": "*",
    "limit": "22.9 kB",
    "ignore": [
      "./leaflet.mjs",
      "./google.mjs",
      "./maplibre.mjs",
      "./photon.mjs",
      "./webmcp.mjs",
      "../leaflet.mjs",
      "../google.mjs",
      "../maplibre.mjs",
      "../photon.mjs",
      "../webmcp.mjs",
      "./_chunks/combobox-*",
      "./combobox-*"
    ]
  },
  {
    "name": "leaflet adapter: import { leafletProvider } (own bytes: lazy photon and core chunks ignored)",
    "path": "dist/leaflet.mjs",
    "import": "{ leafletProvider }",
    "limit": "2.1 kB",
    "ignore": ["./photon.mjs", "./_chunks/errors-*", "./_chunks/normalize-*", "./_chunks/core-*"]
  },
  {
    "name": "google adapter: import { googleProvider }",
    "path": "dist/google.mjs",
    "import": "{ googleProvider }",
    "limit": "2 kB"
  },
  {
    "name": "maplibre adapter: import { maplibreProvider } (own bytes: lazy photon and core chunks ignored)",
    "path": "dist/maplibre.mjs",
    "import": "{ maplibreProvider }",
    "limit": "2 kB",
    "ignore": ["./photon.mjs", "./_chunks/errors-*", "./_chunks/normalize-*", "./_chunks/core-*"]
  },
  {
    "name": "search combobox chunk (as shipped)",
    "path": "dist/_chunks/combobox-*.mjs",
    "disablePlugins": ["@size-limit/esbuild"],
    "limit": "1.7 kB"
  },
  {
    "name": "photon: import { photonGeocoder }",
    "path": "dist/photon.mjs",
    "import": "{ photonGeocoder }",
    "limit": "0.9 kB"
  },
  {
    "name": "webmcp: import { registerWebMcpTools }",
    "path": "dist/webmcp.mjs",
    "import": "{ registerWebMcpTools }",
    "limit": "1.8 kB"
  },
  {
    "name": "location-picker.global.js (IIFE, as shipped)",
    "path": "dist/location-picker.global.js",
    "disablePlugins": ["@size-limit/esbuild"],
    "limit": "28.45 kB"
  },
  {
    "name": "location-picker.min.js (frozen v1, as shipped)",
    "path": "dist/location-picker.min.js",
    "disablePlugins": ["@size-limit/esbuild"],
    "limit": "1.8 kB"
  },
  {
    "name": "location-picker.css (as shipped)",
    "path": "dist/location-picker.css",
    "disablePlugins": ["@size-limit/esbuild"],
    "limit": "1.1 kB"
  }
]
