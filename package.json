{
  "name": "location-picker",
  "version": "3.0.0",
  "description": "Form-ready map location picker: pan a map under a fixed pin to pick one latitude/longitude. Web component + class, keyless OpenStreetMap by default, Google and MapLibre optional.",
  "license": "MIT",
  "type": "commonjs",
  "author": "Rayan Salhab",
  "homepage": "https://cyphercodes.github.io/location-picker/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cyphercodes/location-picker.git"
  },
  "bugs": {
    "url": "https://github.com/cyphercodes/location-picker/issues"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "unpkg": "./dist/location-picker.global.js",
  "jsdelivr": "./dist/location-picker.global.js",
  "customElements": "./custom-elements.json",
  "sideEffects": [
    "./dist/index.mjs",
    "./dist/index.cjs",
    "./dist/element.mjs",
    "./dist/element.cjs",
    "./dist/location-picker.global.js",
    "./dist/location-picker.min.js",
    "*.css"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core.d.mts",
        "default": "./dist/core.mjs"
      },
      "require": {
        "types": "./dist/core.d.cts",
        "default": "./dist/core.cjs"
      }
    },
    "./element": {
      "import": {
        "types": "./dist/element.d.mts",
        "default": "./dist/element.mjs"
      },
      "require": {
        "types": "./dist/element.d.cts",
        "default": "./dist/element.cjs"
      }
    },
    "./utils": {
      "import": {
        "types": "./dist/utils.d.mts",
        "default": "./dist/utils.mjs"
      },
      "require": {
        "types": "./dist/utils.d.cts",
        "default": "./dist/utils.cjs"
      }
    },
    "./leaflet": {
      "import": {
        "types": "./dist/leaflet.d.mts",
        "default": "./dist/leaflet.mjs"
      },
      "require": {
        "types": "./dist/leaflet.d.cts",
        "default": "./dist/leaflet.cjs"
      }
    },
    "./google": {
      "import": {
        "types": "./dist/google.d.mts",
        "default": "./dist/google.mjs"
      },
      "require": {
        "types": "./dist/google.d.cts",
        "default": "./dist/google.cjs"
      }
    },
    "./maplibre": {
      "import": {
        "types": "./dist/maplibre.d.mts",
        "default": "./dist/maplibre.mjs"
      },
      "require": {
        "types": "./dist/maplibre.d.cts",
        "default": "./dist/maplibre.cjs"
      }
    },
    "./photon": {
      "import": {
        "types": "./dist/photon.d.mts",
        "default": "./dist/photon.mjs"
      },
      "require": {
        "types": "./dist/photon.d.cts",
        "default": "./dist/photon.cjs"
      }
    },
    "./webmcp": {
      "import": {
        "types": "./dist/webmcp.d.mts",
        "default": "./dist/webmcp.mjs"
      },
      "require": {
        "types": "./dist/webmcp.d.cts",
        "default": "./dist/webmcp.cjs"
      }
    },
    "./style.css": {
      "types": "./dist/style.css.d.ts",
      "default": "./dist/location-picker.css"
    },
    "./global": {
      "types": "./dist/global.d.ts",
      "default": "./dist/location-picker.global.js"
    },
    "./v1": {
      "types": "./dist/location-picker.min.d.ts",
      "default": "./dist/location-picker.min.js"
    },
    "./dist/location-picker.min.js": {
      "types": "./dist/location-picker.min.d.ts",
      "default": "./dist/location-picker.min.js"
    },
    "./jsx/react": {
      "types": "./dist/jsx/react.d.ts",
      "default": "./dist/jsx/empty.js"
    },
    "./jsx/preact": {
      "types": "./dist/jsx/preact.d.ts",
      "default": "./dist/jsx/empty.js"
    },
    "./jsx/solid": {
      "types": "./dist/jsx/solid.d.ts",
      "default": "./dist/jsx/empty.js"
    },
    "./jsx/vue": {
      "types": "./dist/jsx/vue.d.ts",
      "default": "./dist/jsx/empty.js"
    },
    "./jsx/svelte": {
      "types": "./dist/jsx/svelte.d.ts",
      "default": "./dist/jsx/empty.js"
    },
    "./custom-elements.json": "./custom-elements.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "custom-elements.json",
    "skills",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@types/google.maps": ">=3.58",
    "leaflet": "^1.9.4 || ^2.0.0-0",
    "maplibre-gl": ">=5"
  },
  "peerDependenciesMeta": {
    "@types/google.maps": {
      "optional": true
    },
    "leaflet": {
      "optional": true
    },
    "maplibre-gl": {
      "optional": true
    }
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.22",
      "onFail": "error"
    }
  },
  "keywords": [
    "location-picker",
    "location",
    "map-picker",
    "coordinate-picker",
    "lat-long",
    "latitude",
    "longitude",
    "latlng",
    "coordinates",
    "geolocation",
    "geocoding",
    "reverse-geocoding",
    "address",
    "pin",
    "map",
    "form",
    "form-control",
    "form-associated",
    "web-component",
    "custom-element",
    "leaflet",
    "openstreetmap",
    "google-maps",
    "maplibre",
    "no-api-key",
    "webmcp",
    "ai-friendly"
  ],
  "scripts": {
    "build": "tsdown && cem analyze",
    "build:v1": "node scripts/minify-v1.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit --configLoader runner",
    "test:browser": "vitest run --project browser --configLoader runner",
    "test:e2e": "playwright test",
    "compat": "COMPAT_FULL=1 playwright test",
    "size": "size-limit --ignore-missing",
    "publint": "publint --strict",
    "attw": "attw --pack . --profile node16",
    "check:package": "node scripts/pack-check.mjs && npm run publint && npm run attw && npm run size",
    "types-matrix": "node types-matrix/run.mjs --ts 5.9.3,7.0.2 --mode bundler,nodenext-esm,nodenext-cjs",
    "types-matrix:full": "node types-matrix/run.mjs",
    "docs:test": "node scripts/extract-snippets.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@axe-core/playwright": "4.14.0",
    "@custom-elements-manifest/analyzer": "0.11.0",
    "@playwright/test": "1.63.0",
    "@size-limit/esbuild": "14.2.0",
    "@size-limit/file": "14.2.0",
    "@tsdown/css": "0.23.1",
    "@types/google.maps": "3.66.7",
    "@types/leaflet": "1.9.22",
    "@types/node": "22.20.5",
    "@vitest/browser-playwright": "5.0.5",
    "acorn": "8.16.0",
    "axe-core": "4.14.0",
    "esbuild": "0.28.2",
    "jsdom": "30.1.3",
    "leaflet": "1.9.4",
    "maplibre-gl": "6.14.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "playwright": "1.63.0",
    "prettier": "3.9.10",
    "publint": "0.3.25",
    "size-limit": "14.2.0",
    "terser": "5.51.2",
    "tsdown": "0.23.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
